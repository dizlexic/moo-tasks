NUXT_SESSION_PASSWORD=replace-with-a-secure-random-string-of-at-least-32-characters

BASE_URL=http://localhost:3000
# Application Port
PORT=3000
HOST=localhost

# Host-run app settings; Compose uses the internal host `db` and port 3306.
DB_ROOT_PASSWORD=password
DB_USER=mootasks
DB_PASSWORD=password
DB_NAME=mootasks
DB_PORT=3306
DB_HOST=localhost
DB_LOCAL_PORT=3307

# Application Secrets
# Need at least 32 characters

# SMTP Configuration
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
